APP_NAME="IWT AI Sales Platform"
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
API_PORT=8000

POSTGRES_DB=iwt_ai_sales
POSTGRES_USER=iwt
POSTGRES_PASSWORD=iwt
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://iwt:iwt@db:5432/iwt_ai_sales

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CATALOG_API_URL=
CATALOG_API_KEY=
CATALOG_TIMEOUT=10

WEBSITE_API_URL=
WEBSITE_API_KEY=
WEBSITE_API_TIMEOUT=10
WEBSITE_API_AUTH_MODE=none
WEBSITE_CATALOG_IBLOCK_ID=86

MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_API_TIMEOUT=10
# true только локально, если Windows/антивирус ломает TLS к MAX API
MAX_TLS_INSECURE=false

# Meta WhatsApp Cloud API (Sprint 17)
# Публичный номер WhatsApp IWT: +79034770088
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_TIMEOUT=10

# Public iwt.ru catalog (HTML) — preferred product source without Bitrix
IWT_STORE_ENABLED=true
IWT_STORE_BASE_URL=https://www.iwt.ru
IWT_STORE_TIMEOUT=15
IWT_STORE_MAX_PRODUCTS=8
# Optional Bitrix webhook fallback (leave empty if no Bitrix access)
# WEBSITE_API_URL=
