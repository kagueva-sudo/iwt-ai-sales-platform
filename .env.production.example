APP_NAME="IWT AI Sales Platform"
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
API_PORT=8000

POSTGRES_DB=iwt_ai_sales
POSTGRES_USER=iwt_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://iwt_app:CHANGE_ME_STRONG_PASSWORD@db:5432/iwt_ai_sales

OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

CATALOG_API_URL=https://catalog-api.example.com
CATALOG_API_KEY=CHANGE_ME_CATALOG_API_KEY
CATALOG_TIMEOUT=10

WEBSITE_API_URL=https://iwt.ru/rest/1/YOUR_WEBHOOK_CODE
WEBSITE_API_KEY=
WEBSITE_API_TIMEOUT=10
WEBSITE_API_AUTH_MODE=none
WEBSITE_CATALOG_IBLOCK_ID=86

MAX_BOT_TOKEN=CHANGE_ME_MAX_BOT_TOKEN
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_API_TIMEOUT=10
# MAX_TLS_INSECURE=false

WHATSAPP_ACCESS_TOKEN=CHANGE_ME_WHATSAPP_ACCESS_TOKEN
# Phone Number ID из Meta (не сам номер). Публичный WhatsApp IWT: +79034770088
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=iwt-wa-verify-9f3c2a7b
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_TIMEOUT=10

# Public iwt.ru catalog (HTML) — preferred product source without Bitrix
IWT_STORE_ENABLED=true
IWT_STORE_BASE_URL=https://www.iwt.ru
IWT_STORE_TIMEOUT=15
IWT_STORE_MAX_PRODUCTS=8
# Optional Bitrix webhook fallback (leave empty if no Bitrix access)
# WEBSITE_API_URL=
